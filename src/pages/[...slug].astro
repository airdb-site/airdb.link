---
import BaseLayout from "../layouts/BaseLayout.astro";
import LinkHome from "../components/LinkHome.astro";
import { getAllPages, getChildren, getLanguageMenus, getLanguageOptions, getPageBySegments, getSiblingPages } from "../lib/content";
import { getLanguageMeta } from "../config/site";

export function getStaticPaths() {
  return getAllPages().map((page) => ({ params: { slug: page.routeSegments.join("/") } }));
}

const slug = Astro.params.slug ?? "";
const page = getPageBySegments(slug.split("/").filter(Boolean));
if (!page) throw new Error(`Missing page for route: ${slug}`);

const menus = getLanguageMenus(page.lang);
const languageMeta = getLanguageMeta(page.lang);
const children = getChildren(page);
const siblings = getSiblingPages(page);
const languageOptions = getLanguageOptions(page, { zh: "中文", cc: "EN" });
const sidebarNav = page.lang === "zh" && page.routePath.startsWith("/zh/about") ? menus.docs : siblings.map((item) => ({ name: item.title, url: item.routePath }));
---

<BaseLayout
  title={`${page.isIndex ? "可信的软件链接基础设施" : page.title} | airdb.link`}
  description={page.isIndex ? "为软件、文档与发布版本创建稳定、可验证、可审计的链接。" : page.description}
  globalNav={menus.global}
  sidebarNav={sidebarNav}
  languageOptions={languageOptions}
  currentPath={page.routePath}
  htmlLang={languageMeta.htmlLang}
  homePath={languageMeta.homePath}
  footerTitle={languageMeta.footerTitle}
  footerCopy={languageMeta.footerCopy}
  copyrightLabel={languageMeta.copyrightLabel}
  filingLabel={languageMeta.filingLabel}
  filingUrl={languageMeta.filingUrl}
  homeMode={page.isIndex}
>
  {page.isIndex ? <LinkHome lang={page.lang} /> : (
    <article class="article-shell">
      <header class="article-header">
        <h1>{page.title}</h1>
        {page.description && <p class="article-description">{page.description}</p>}
        <div class="article-meta"><span>{languageMeta.articleLeadLabel}</span><span>{page.section ?? page.lang}</span></div>
      </header>
      <div class="prose" set:html={page.html} />
      {children.length > 0 && <section class="children-grid"><h2>{languageMeta.articleContinueLabel}</h2><div class="card-grid">{children.map((child) => <a class="card-link" href={child.routePath}><h3>{child.title}</h3><p>{child.description}</p></a>)}</div></section>}
    </article>
  )}
</BaseLayout>
