---
const { lang = "zh" } = Astro.props;
const isZh = lang === "zh";
---

<div class="link-home">
  <p class="demo-notice">{isZh ? '交互演示：数据、历史和审批均为示例；不会创建短链接、验证所有权或保存记录。' : 'Interactive demo: data, history, and approvals are examples. No links are created, ownership verified, or records saved.'}</p>
  <section class="link-hero">
    <div class="link-hero-copy">
      <h1>{isZh ? "每个软件，都值得一个可信的地址" : "Every piece of software deserves a trusted address"}</h1>
      <p>{isZh ? "为软件、文档与发布版本创建稳定链接。每次跳转、变更与归属都有据可查。" : "Create stable links for software, documentation, and releases. Every redirect, change, and owner stays traceable."}</p>
      <div class="link-actions">
        <a class="link-button primary" href="#resolver">{isZh ? "试用演示" : "Try the demo"}</a>
        <a class="link-button secondary" href="#directory">{isZh ? "查看公开目录" : "Browse directory"}</a>
      </div>
    </div>
    <div class="route-map" aria-label="Redis link routes">
      <div class="route-origin"><i></i><strong>airdb.link/redis</strong></div>
      <svg viewBox="0 0 460 230" aria-hidden="true"><path d="M8 115H70c46 0 34-84 82-84h46M70 115h128M70 115c46 0 34 84 82 84h46"/><circle cx="204" cy="31" r="5"/><circle cx="204" cy="115" r="5"/><circle cx="204" cy="199" r="5"/></svg>
      <div class="route-target current"><span>◎</span><div><b>redis.io</b><small>{isZh ? "当前" : "current"}</small></div></div>
      <div class="route-target docs"><span>□</span><div><b>{isZh ? "文档" : "Docs"}</b><code>redis.io/docs/latest</code></div></div>
      <div class="route-target download"><span>↓</span><div><b>{isZh ? "下载" : "Download"}</b><code>redis.io/download</code></div></div>
    </div>
  </section>

  <section class="resolver" id="resolver">
    <form class="resolver-form" data-resolver>
      <label><span>airdb.link/</span><input name="slug" value="redis" aria-label="Link alias" /></label>
      <input name="target" type="url" required value="https://redis.io/" aria-label="Target URL" />
      <button type="submit">{isZh ? "解析" : "Resolve"}</button>
    </form>
    <div class="resolver-result" aria-live="polite">
      <div><small>{isZh ? "当前指向" : "Current target"}</small><strong data-domain>redis.io ↗</strong></div>
      <div><small>{isZh ? "状态" : "Status"}</small><strong class="verified">✓ {isZh ? "未验证 · 演示" : "Unverified · demo"}</strong></div>
      <div><small>{isZh ? "示例所有者" : "Example owner"}</small><strong>Redis</strong></div>
      <div><small>{isZh ? "最后变更" : "Last changed"}</small><strong>2026-08-03</strong></div>
    </div>
    <div class="route-history"><strong>{isZh ? "历史路由" : "Route history"}</strong><code>v8.2</code><span>→</span><b>redis.io/download</b><time>2026-06-15</time><code>docs</code><span>→</span><b>redis.io/docs/latest</b><time>2026-04-12</time></div>
  </section>

  <section class="directory-section" id="directory">
    <div class="section-title"><h2>{isZh ? "不是一串短码，而是一份链接档案" : "Not just a short code. A link record."}</h2><a href="#directory">{isZh ? "3 个示例链接" : "3 example links"}</a></div>
    <div class="link-table" role="region" aria-label="Example links" tabindex="0">
      <div class="table-row table-head"><span>{isZh ? "别名" : "Alias"}</span><span>{isZh ? "目标地址" : "Target"}</span><span>{isZh ? "类型" : "Type"}</span><span>{isZh ? "示例所有者" : "Example owner"}</span><span>{isZh ? "最近验证" : "Verified"}</span></div>
      {[["redis","https://redis.io/","官网","Redis","2026-08-03"],["postgresql","https://www.postgresql.org/","官网","PostgreSQL","2026-08-02"],["kubernetes","https://kubernetes.io/","官网","Kubernetes","2026-08-01"]].map((row) => <a class="table-row" href={`https://${row[1].replace(/^https?:\/\//, "")}`} target="_blank" rel="noopener noreferrer"><b>{row[0]}</b><code>{row[1]} ↗</code><span>◎ {isZh ? row[2] : "Official"}</span><span>{row[3]}</span><span class="verified">✓ {row[4]}</span></a>)}
    </div>
  </section>

  <section class="audit-section" id="audit">
    <div class="section-title"><h2>{isZh ? "每次改变，都留下理由" : "Every change leaves a reason"}</h2><p>{isZh ? "目标地址可以变化，责任链不能断。" : "Targets can change. Accountability cannot."}</p></div>
    <div class="audit-list" tabindex="0" role="region" aria-label="Example audit history">
      {[
        ["2026-08-03 10:42", "alice@redis.io", "https://redis.io", "https://redis.io/", "规范尾斜杠以统一地址"],
        ["2026-06-15 09:18", "bob@redis.io", "https://download.redis.io/", "https://redis.io/download", "迁移下载入口至新域名"],
        ["2026-04-12 16:07", "carol@redis.io", "—", "https://redis.io/docs/latest", "新增文档别名路由"],
      ].map((row, i) => <button class:list={["audit-row", i === 0 && "selected"]} type="button"><i></i><time>{row[0]}</time><span>{row[1]}</span><code>{row[2]}</code><em>→</em><code>{row[3]}</code><b>✓ {isZh ? "示例审批" : "Example approval"}</b><span>{isZh ? row[4] : ["Normalize canonical URL", "Move download endpoint", "Add documentation alias"][i]}</span></button>)}
    </div>
  </section>

  <section class="capability-strip">
    <article><span>↗</span><h3>{isZh ? "稳定别名" : "Stable aliases"}</h3><p>{isZh ? "为软件与文档提供可读、永久的别名。目标可变，地址不变。" : "Readable, durable aliases for software and docs."}</p><code>airdb.link/redis → redis.io</code></article>
    <article><span>⌘</span><h3>{isZh ? "版本路由" : "Version routing"}</h3><p>{isZh ? "按版本、渠道或用途路由到最合适的目标。" : "Route by version, channel, or purpose."}</p><code>airdb.link/redis/v8.2</code></article>
    <article><span>◇</span><h3>{isZh ? "可审计变更" : "Auditable changes"}</h3><p>{isZh ? "每次变更都有记录、理由与审批，责任可追溯。" : "Every change has history, rationale, and approval."}</p><code>{isZh ? "审计日志 · 审批流 · 回滚支持" : "Audit · approval · rollback"}</code></article>
  </section>

  <section class="link-cta"><div class="cta-route">◎<i></i></div><div><h2>{isZh ? "给你的软件一个长期地址" : "Give your software a lasting address"}</h2><p>{isZh ? "建立可信的链接基础设施，让用户、团队与时间都在你这边。" : "Build link infrastructure that lasts across users, teams, and time."}</p></div><a class="link-button primary" href="#resolver">{isZh ? "体验链接演示 ＋" : "Try the link demo +"}</a></section>
</div>

<script>
  document.querySelector('[data-resolver]')?.addEventListener('submit', (event) => {
    event.preventDefault();
    const form = event.currentTarget;
    if (!(form instanceof HTMLFormElement)) return;
    const target = new FormData(form).get('target')?.toString() || '';
    const output = document.querySelector('[data-domain]');
    if (!output) return;
    try {
      const url = new URL(target);
      if (!['http:', 'https:'].includes(url.protocol)) throw new Error('Unsupported protocol');
      output.textContent = url.hostname;
    } catch { output.textContent = 'Invalid HTTP(S) URL / 无效地址'; }
  });
  document.querySelectorAll('.audit-row').forEach((row) => row.addEventListener('click', () => {
    document.querySelectorAll('.audit-row').forEach((item) => item.classList.remove('selected'));
    row.classList.add('selected');
  }));
</script>
